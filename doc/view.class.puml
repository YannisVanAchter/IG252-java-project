class ViewUtils {
    {static} +createColumnPanel() : JPanel
    {static} +labeled(text : String, comp : JComponent) : JPanel
    {static} +labeled(checkBox : JCheckBox, comp : JComponent) : JPanel
    {static} +labeledRequired(labelText : String, comp : JComponent) : JPanel
    {static} +createDateSpinner() : JSpinner
    {static} +labeledToggleDate(label : String, spinner : JSpinner, chk : JCheckBox) : JPanel
    {static} +createNumberSpinner(value : int, min : int, max : int, step : int) : JSpinner
    {static} +getDate(spinner : JSpinner) : LocalDate
    {static} +toDate(localDate : LocalDate) : Date
    {static} +toLocalDate(date : Date) : LocalDate
    {static} +addFilterListener(textField : JTextField, onFilter : Runnable) : JTextField
    {static} +addFilterListener(checkBox : JCheckBox, onFilter : Runnable) : JCheckBox
    {static} +addFilterListener(combo : JComboBox<T>, onFilter : Runnable) : JComboBox<T>
    {static} +digitsOnly(textField : JTextField) : JTextField
}

class ComboBoxItem<T> {
    - object: T
    - label: String

    + ComboBoxItem(object: T, label: String)
    + getObject(): T
    + toString(): String
    + selectComboItem(combo: JComboBox<ComboBoxItem<T>>, object: T): void
}

