@startuml "diagramme de classe"
skinparam linetype ortho

class Main

package view {

    class MainWindow{
        -title : String
    }

    class MenuWindow{
        -mainPanel : JPanel
        -appMenu : JMenu
        -appItem : JMenuItem

        +openDocumentForm() : void
        +openClientSupplierForm() : void
        +openProductSearchForm() : void
        +openRecipeSearchForm() : void
    }

    'CRUD 1'
    'Read '
    class DocumentTable {
        -documents : ArrayList<Document> 'All docs'
        -displayDocuments : ArrayList<Document> 'Displayed docs in the table'
        -typeDocmentFilter : JComboBox
        -startCreationDate : JDatePicker
        -endCreationDate : JDatePicker

        +onFilterClick() : void
        +onCreateClick() : void
        +onUpdateClick(Document) : void
        +onDeleteClick(Document) : void
    }

    'Create'
    class DocumentCreationForm {
        -name : JTextField
        -commentary : JTextArea
        -checkIsChecked : JCheckBox
        -pickerPlannedSendDate : JDatePicker
        -pickerPlannedReceptionDate : JDatePicker
        -pickerEffectiveSendDate : JDatePicker
        -pickerEffectiveReceptionDate : JDatePicker
        -pickerPaymentDelay : JDatePicker
        -comboWorkflow : JComboBox
        -comboClientSupplier : JComboBox
        -comboAddress : JComboBox
        -table : JTable

        +onSaveClicked() : void
        +clearForm() : void
    }

    'Update'
    class DocumentUpdateForm {
        -name : JTextField
        -commentary : JTextArea
        -checkIsChecked : JCheckBox
        -pickerPlannedSendDate : JDatePicker
        -pickerPlannedReceptionDate : JDatePicker
        -pickerEffectiveSendDate : JDatePicker
        -pickerEffectiveReceptionDate : JDatePicker
        -pickerPaymentDelay : JDatePicker
        -comboWorkflow : JComboBox
        -comboClientSupplier : JComboBox
        -comboAddress : JComboBox
        -table : JTable

        +onValidateClick(Document) : void
        +onCancelClick() : void
    }

    'CRUD 2 '
    'Read' 
    class ClientSupplierTable {

    }

    'Create' 
    class ClientSupplierForm {
        -txtName : JTextField
        -txtFirstName : JTextField
        -txtEmail : JTextField
        -txtVATNumber : JTextField
        -pickerDateBecameClient : JDatePicker
        -boxIsClient : JCheckBox
        -boxIsSupplier : JCheckBox
        -boxIsUs : JCheckBox
        -spnFidelityPoints : JSpinner
        -table : JTable

        +displayClients(List<ClientSupplier>) : void
        +onSaveClicked() : void
        +onUpdateClicked() : void
        +onDeleteClicked() : void
        +clearForm() : void
    }

    'Recherche 1 '
    class ProductSearchForm {
        -txtProductName : JTextField
        -comboCategory : JComboBox
        -promotion : JCheckBox
        -btnSearch : JButton
        -table : JTable

        +onSearchClicked() : void
        +clearForm() : void
        +displayResults(List<Product>) : void
    }

    'Recherche 2 '
    class RecipeSearchForm {
        -txtName : JTextField
        -txtProduct : JTextField
        -table : JTable

        +onSearchClicked() : void
        +clearForm() : void
        +displayResults(List<Recipe>) : void
    }

    'Recherche 3 '
    class ClientSupplierSearchForm {
        -txtName : JTextField
        -txtEmail : JTextField
        -boxFidelityValid : JCheckBox
        -table : JTable

        +onLoadClicked() : void
        +onSearchClicked() : void
        +clearForm() : void
        +displayResults(List<ClientSupplier>) : void
    }

    Main --> MainWindow
    MainWindow --> MenuWindow

    MenuWindow --> ClientSupplierForm
    MenuWindow --> DocumentTable
    MenuWindow --> RecipeSearchForm
    MenuWindow --> ProductSearchForm
    MenuWindow --> ClientSupplierSearchForm
    MenuWindow --> ClientSupplierTable

    DocumentTable --> DocumentUpdateForm
    DocumentTable --> DocumentCreationForm
}

package controller {

    class DocumentController {
        +getAllDocuments() : List<Document>
        +createDocument(title : String, commentary : String) : void
        +updateDocument(id : int, title : String, commentary : String) : void
        +deleteDocument(id : int) : void
    }

    class ClientSupplierController {
        +getAllClientsSuppliers() : List<ClientSupplier>
        +createClientSupplier(name : String, email : String) : void
        +updateClientSupplier(id : int, name : String, email : String) : void
        +deleteClientSupplier(id : int) : void
    }

    class ProductSearchController {
        +searchProducts(name : String, category : String, promotion : boolean) : List<Product>
    }

    class RecipeSearchController {
        +searchRecipes(name : String, product : String) : List<Recipe>
    }

    class ClientSupplierSearchController {
        +search(name : String, email : String, fidelityValid : boolean) : List<ClientSupplier>
    }
}

' VIEW → CONTROLLER
DocumentCreationForm --> DocumentController
DocumentTable --> DocumentController
DocumentUpdateForm --> DocumentController
ClientSupplierForm --> ClientSupplierController
ClientSupplierTable --> ClientSupplierController
ProductSearchForm --> ProductSearchController
RecipeSearchForm --> RecipeSearchController
ClientSupplierSearchForm --> ClientSupplierSearchController

package business {

    class DocumentManager {
        +getAllDocuments() : List<Document>
        +createDocument(title : String, commentary : String) : void
        +updateDocument(id : int, title : String, commentary : String) : void
        +deleteDocument(id : int) : void
    }

    class ClientSupplierManager {
        +getAllClientsSuppliers() : List<ClientSupplier>
        +createClientSupplier(name : String, email : String) : void
        +updateClientSupplier(id : int, name : String, email : String) : void
        +deleteClientSupplier(id : int) : void
    }

    class ProductManager {
        +searchProducts(name : String, category : String, promotion : boolean) : List<Product>
    }

    class RecipeSearchManager {
        +searchRecipes(name : String, product : String) : List<Recipe>
    }
}

' CONTROLLER → BUSINESS
DocumentController --> DocumentManager
ClientSupplierController --> ClientSupplierManager
ProductSearchController --> ProductManager
RecipeSearchController --> RecipeSearchManager
ClientSupplierSearchController --> ClientSupplierManager

package data {

    class SingletonConnection {
        -connexionUnique : Connection
        +getInstance() : Connection
    }

    class ClientSupplierDBAccess {
        +getAll() : List<ClientSupplier>
        +getById(id : int) : ClientSupplier
        +insert(c : ClientSupplier) : void
        +update(c : ClientSupplier) : void
        +delete(id : int) : void
    }

    class EmployeeDBAccess {
        +getAll() : List<Employee>
        +getByMatricule(matricule : int) : Employee
        +insert(e : Employee) : void
        +update(e : Employee) : void
        +delete(matricule : int) : void
    }

    class DocumentDBAccess {
        +getAll() : List<Document>
        +getById(id : int) : Document
        +insert(d : Document) : void
        +update(d : Document) : void
        +delete(id : int) : void
    }

    class ProductDBAccess {
        +getAll() : List<Product>
        +getById(id : int) : Product
        +insert(p : Product) : void
        +update(p : Product) : void
        +delete(id : int) : void
    }

    class RecipeDBAccess {
        +getAll() : List<Recipe>
        +getById(id : int) : Recipe
        +insert(r : Recipe) : void
        +update(r : Recipe) : void
        +delete(id : int) : void
    }

    ClientSupplierDBAccess --> SingletonConnection
    EmployeeDBAccess --> SingletonConnection
    DocumentDBAccess --> SingletonConnection
    ProductDBAccess --> SingletonConnection
    RecipeDBAccess --> SingletonConnection

}

' BUSINESS → DATA
DocumentManager --> DocumentDBAccess
ClientSupplierManager --> ClientSupplierDBAccess
ProductManager --> ProductDBAccess
RecipeSearchManager --> RecipeDBAccess

package exception {
    exception InvalidUserException

    exception InvalidClientSupplierException
    exception InvalidDocumentException
    exception InvalidProductException
    exception InvalidRecipeException
    exception NotFoundException

    exception DataValidationException
    exception DatabaseConnectionException
}

' EXCEPTIONS
DocumentController ..> InvalidDocumentException
ClientSupplierController ..> InvalidClientSupplierException
ProductSearchController ..> InvalidProductException
RecipeSearchController ..> InvalidRecipeException

DocumentManager ..> DataValidationException
ClientSupplierManager ..> DataValidationException
ProductManager ..> DataValidationException
RecipeSearchManager ..> DataValidationException

DocumentDBAccess ..> DatabaseConnectionException
ClientSupplierDBAccess ..> DatabaseConnectionException
ProductDBAccess ..> DatabaseConnectionException
RecipeDBAccess ..> DatabaseConnectionException

package model {
    class Locality {
        -postalCode : int
        -city : String
    }

    class Address {
        -streetName : String
        -streetNumber : int
    }

    Address --> Locality

    class Employee {
        -matricule : String
        -lastname : String
        -firstname : String
        -phoneNumber : String
        -email : String
        -IBAN : String
        -salaryPerHour : float
        -nbHourPerWeek : int
        -entryDate : Date
        -nbPaidHoliday : int
        -password : String
    }

    Employee --> Address
    Employee "0..*" --> "0..1" Employee : manager

    class Pointage {
        -date : Date
        -startTime : Time
        -endTime : Time
    }

    Pointage "*" --> "1" Employee

    class Function {
        -name : String
    }

    class Position {
    }

    Position "*" --> "*" Employee
    Position "*" --> "1" Function

    class AbsenceType {
        -name : String
    }

    class Absence {
        -startDate : Date
        -endDate : Date
        -description : String
    }

    Absence "*" --> "1" AbsenceType
    Absence "*" --> "1" Employee

    class ClientSupplier {
        -id : int
        -name : String
        -firstName : String
        -email : String
        -phoneNumber : String
        -isClient : bool
        -isSupplier : bool
        -VATNumber : String
        -dateBecameClient : Date
    }

    ClientSupplier "*" --> "1" Address

    class FidelityCard {
        -id : int
        -totalPoint : int
        -isValid : bool
    }

    FidelityCard "1" --> "1" ClientSupplier

    class WorkflowType {
        -name : String
        -isBuy : bool
        -isSupplier : bool
        -isInternal : bool
    }

    class Status {
        -name : String
    }

    class Workflow {
        -id : String
    }

    Workflow "*" --> "1" Status
    Workflow "*" --> "1" WorkflowType

    class Document {
        -id : int
        -date : Date
        -plannedSendDate : Date
        -plannedReceptionDate : Date
        -effectiveSendDate : Date
        -effectiveReceptionDate : Date
        -paymentDelay : int
        -commentary : String
        -isChecked : bool
    }

    Document "*" --> "1" Workflow
    Document "*" --> "1" ClientSupplier
    Document "*" --> "1" Address

    class ProductCategory {
        -name : String
    }

    class Product {
        -id : int
        -name : String
        -price : float
        -VAT : int
        -fidelityPoint : int
    }

    Product "*" --> "1" ProductCategory

    class Promotion {
        -requiredQuantity : int
        -discount : int
        -startDate : Date
        -endDate : Date
        -name : String
    }

    Promotion "*" --> "*" Product

    class Location {
        -shelf : String
        -floor : String
    }

    class Quantity {
        -nbProduct : int
    }

    Quantity "*" --> "1" Product
    Quantity "*" --> "1" Location

    class Recipe {
        -name : String
        -explanation : String
    }

    class Composition {
        -quantity : int
    }

    Composition "*" --> "1" Recipe
    Composition "*" --> "1" Product

    class Detail {
        -id : int
        -quantity : float
        -price : float
    }

    Detail "*" --> "1" Document
    Detail "*" --> "1" Product

    class Batch {
        -id : int
        -expirationDate : Date
        -originCountry : String
    }

    Batch "*" --> "1" Product
    Batch "*" --> "1" Detail
}

' MODEL
' DocumentController ..> Document
' ClientSupplierController ..> ClientSupplier
' ProductSearchController ..> Product
' RecipeSearchController ..> Recipe

' DocumentManager ..> Document
' ClientSupplierManager ..> ClientSupplier
' ProductManager ..> Product
' RecipeSearchManager ..> Recipe

' DocumentDBAccess ..> Document
' ClientSupplierDBAccess ..> ClientSupplier
' ProductDBAccess ..> Product
' RecipeDBAccess ..> Recipe

view ..> model
controller ..> model
business ..> model
data ..> model


@enduml