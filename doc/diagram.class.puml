        -selectedProducts : ArrayList<ProductRowViewModel>
        -productTable : JTable

        +onSupplierSelected(supplier :ClientSupplier) : void
        +onCreatePurchaseOrderClicked() : void
    }
    class OrderCreationView {
        -selectedSupplier :ClientSupplier
