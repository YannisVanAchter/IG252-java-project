    }

    'Tâche métier 2'
    class TicketView {
        - txtSearchProduct : JTextField
        - btnScan : JButton
        - productTable : JTable
        - ticketTable : JTable
        - btnAddItem : JButton
        - btnRemoveItem : JButton
        - btnNext : JButton

        + displayProducts(products : ArrayList<Product>) : void
        + displayCart(items : ArrayList<TicketItem>) : void
