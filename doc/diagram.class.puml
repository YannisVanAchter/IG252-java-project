        +delete(matricule : int) : void
    }

    class DocumentDBAccess {
        +getAll() : List<Document>
        +getById(id : int) : Document
        +insert(d : Document) : void
        +update(d : Document) : void
        +delete(id : int) : void
    }

    class ProductDBAccess {
        +getAll() : List<Product>
        +getById(id : int) : Product
        +insert(p : Product) : void
        +update(p : Product) : void
        +delete(id : int) : void
    }

    class RecipeDBAccess {
        +getAll() : List<Recipe>
        +getById(id : int) : Recipe
        +insert(r : Recipe) : void
        +update(r : Recipe) : void
        +delete(id : int) : void
    }

    ClientSupplierDBAccess --> SingletonConnection
    EmployeeDBAccess --> SingletonConnection
    DocumentDBAccess --> SingletonConnection
    ProductDBAccess --> SingletonConnection
    RecipeDBAccess --> SingletonConnection

}

