package business {

    class DocumentManager {
        +getDocuments() : List<Document>
        +getDocument(id : int) : Document
        +getDocumentTypes() : List<TypeDocument>
        +createDocument(commentary : String) : void
        +updateDocument(id : int, commentary : String) : void
        +deleteDocument(id : int) : void

        note "TODO: Update to take into account the different type of documents and there attributes"
    }

    class ClientSupplierManager {
        +getAllClientsSuppliers() : List<ClientSupplier>
        +getClientSupplier(id: int) : ClientSupplier
        +createClientSupplier(name : String, email : String) : void
        +updateClientSupplier(id : int, name : String, email : String) : void
        +deleteClientSupplier(id : int) : void
    }

    class ProductManager {
        +searchProducts(name : String, category : String, promotion : boolean) : List<Product>
        +getAllProduct() : List<Product>
        +getProductSupplier(Product) : List<Product>
