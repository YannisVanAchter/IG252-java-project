package data {

    class SingletonConnection {
        -connexionUnique : Connection
        +getInstance() : Connection
    }

    class ClientSupplierDBAccess {
        +getAll() : List<ClientSupplier>
        +getById(id : int) : ClientSupplier
        +insert(c : ClientSupplier) : void
        +update(c : ClientSupplier) : void
        +delete(id : int) : void
    }

    class EmployeeDBAccess {
        +getAll() : List<Employee>
        +getByMatricule(matricule : int) : Employee
        +insert(e : Employee) : void
        +update(e : Employee) : void
        +delete(matricule : int) : void
    }

    class DocumentDBAccess {
        +getAll() : List<Document>
        +getById(id : int) : Document
        +insert(d : Document) : void
        +update(d : Document) : void
        +delete(id : int) : void
    }

    class ProductDBAccess {
        +getAll() : List<Product>
        +getById(id : int) : Product
        +insert(p : Product) : void
        +update(p : Product) : void
        +delete(id : int) : void
    }

    class RecipeDBAccess {
        +getAll() : List<Recipe>
        +getById(id : int) : Recipe
        +insert(r : Recipe) : void
        +update(r : Recipe) : void
        +delete(id : int) : void
    }

    ClientSupplierDBAccess --> SingletonConnection
